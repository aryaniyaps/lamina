{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/safe-runner-report-v1.json",
  "$comment": "The report slot is invalidated at acquisition with an empty/invalid or current-run internal_error record. LAMINA_SAFE_RUN_IN_PROGRESS is non-success evidence only; completed outcomes require the cleanup invariants below.",
  "title": "Lamina crash-safe runner report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "run_id", "report_file", "outcome", "tier", "command", "cwd",
    "started_at", "finished_at", "duration_ms", "adapter", "limits", "preflight",
    "samples", "peaks", "descendants", "output", "termination", "cleanup", "error"
  ],
  "properties": {
    "schema": { "const": "lamina.safe-runner-report/v1" },
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "report_file": { "type": ["string", "null"] },
    "outcome": {
      "enum": [
        "success", "command_failed", "safety_limit_exceeded", "preflight_refused",
        "interrupted", "internal_error"
      ]
    },
    "tier": { "type": ["string", "null"], "enum": ["small", "medium", "large", null] },
    "command": { "type": "array", "items": { "type": "string" } },
    "cwd": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "adapter": { "type": ["object", "null"] },
    "limits": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["stdout_tail_max_bytes", "stderr_tail_max_bytes"],
          "properties": {
            "stdout_tail_max_bytes": { "type": "integer", "enum": [8192, 1048576] },
            "stderr_tail_max_bytes": { "const": 8192 }
          }
        }
      ]
    },
    "preflight": { "type": ["object", "null"] },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elapsed_ms", "aggregate_rss_bytes", "cgroup_memory_bytes", "pids", "temporary_bytes", "temporary_inodes"],
        "properties": {
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "aggregate_rss_bytes": { "type": "integer", "minimum": 0 },
          "cgroup_memory_bytes": { "type": "integer", "minimum": 0 },
          "pids": { "type": "integer", "minimum": 0 },
          "temporary_bytes": { "type": "integer", "minimum": 0 },
          "temporary_inodes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "peaks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_rss_bytes", "cgroup_memory_bytes", "pids", "temporary_bytes", "temporary_inodes"],
      "properties": {
        "aggregate_rss_bytes": { "type": "integer", "minimum": 0 },
        "cgroup_memory_bytes": { "type": "integer", "minimum": 0 },
        "pids": { "type": "integer", "minimum": 0 },
        "temporary_bytes": { "type": "integer", "minimum": 0 },
        "temporary_inodes": { "type": "integer", "minimum": 0 }
      }
    },
    "descendants": { "type": "array", "items": { "type": "object" } },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_bytes", "stderr_bytes", "total_bytes", "stdout_tail", "stderr_tail", "truncated"],
      "properties": {
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "stdout_tail": { "type": "string" },
        "stderr_tail": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "limit", "requested_signals", "child_exit_code", "child_signal", "cgroup_events"],
      "properties": {
        "reason": { "type": ["string", "null"] },
        "limit": { "type": ["string", "null"] },
        "requested_signals": { "type": "array", "items": { "type": "string" } },
        "child_exit_code": { "type": ["integer", "null"] },
        "child_signal": { "type": ["string", "null"] },
        "cgroup_events": { "type": "object" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "descendants_remaining", "managed_paths_remaining", "scope_removed", "temporary_directory_removed", "lock_released", "errors"],
      "properties": {
        "attempted": { "type": "boolean" },
        "descendants_remaining": { "type": "array", "items": { "type": "integer" } },
        "managed_paths_remaining": { "type": "array", "items": { "type": "string" } },
        "scope_removed": { "type": ["boolean", "null"] },
        "temporary_directory_removed": { "type": ["boolean", "null"] },
        "lock_released": { "type": ["boolean", "null"] },
        "oracle_quota_abort": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
