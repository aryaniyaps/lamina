#!/usr/bin/env bash
set -euo pipefail

for candidate in \
  "${ASE_WORKSPACE_PATH:-$PWD}/.lamina/runtime-cli/bin/lamina" \
  "$PWD/.lamina/runtime-cli/bin/lamina"
do
  if [[ -x "$candidate" ]]; then
    exec "$candidate" "$@"
  fi
done

echo "lamina eval source CLI is not installed in this workspace" >&2
exit 127
