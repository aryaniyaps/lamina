#!/usr/bin/env bash
set -euo pipefail

for candidate in \
  ".codex/skills/lamina-orchestrator/bin/lamina.mjs" \
  ".claude/skills/lamina-orchestrator/bin/lamina.mjs" \
  ".opencode/skills/lamina-orchestrator/bin/lamina.mjs" \
  ".agents/skills/lamina-orchestrator/bin/lamina.mjs"
do
  if [[ -f "$candidate" ]]; then
    exec node "$candidate" "$@"
  fi
done

echo "lamina eval runtime is not installed in this workspace" >&2
exit 127
