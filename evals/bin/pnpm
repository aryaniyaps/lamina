#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
CURRENT_DIR="$(pwd -P)"

if [[ "${1:-}" == "install" || "${1:-}" == "i" ]] &&
  [[ "$CURRENT_DIR" == "$REPO_ROOT/eval-workspace/"* ]]; then
  for arg in "$@"; do
    if [[ "$arg" == "--ignore-workspace" ]]; then
      exec corepack pnpm "$@"
    fi
  done
  exec corepack pnpm "$@" --ignore-workspace
fi

exec corepack pnpm "$@"
