{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/real-repository-oracle-result-v1.json",
  "title": "Lamina real-repository oracle result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter", "collection_id", "collection_digest", "evidence_mode", "claims", "safety", "cases", "replay_digest"],
  "properties": {
    "schema": { "const": "lamina.real-repository-oracle-result/v1" },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["schema", "id", "version", "input_format", "output_format"],
      "properties": {
        "schema": { "const": "lamina.real-repository-oracle-adapter/v1" },
        "id": { "$ref": "#/$defs/nonempty" },
        "version": { "type": "integer", "minimum": 1 },
        "input_format": { "const": "lamina.real-repository-oracle-input/v1" },
        "output_format": { "$ref": "#/$defs/nonempty" }
      }
    },
    "collection_id": { "$ref": "#/$defs/nonempty" },
    "collection_digest": { "$ref": "#/$defs/sha256" },
    "evidence_mode": { "enum": ["oracle_validation", "semantic_core", "public_cli"] },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["end_to_end_runtime", "observation", "obligations", "source_localization"],
      "properties": {
        "end_to_end_runtime": { "type": "boolean" },
        "observation": { "enum": ["brownfield_signals", "public_cli", "not_measured"] },
        "obligations": { "enum": ["compiled", "public_cli", "not_measured"] },
        "source_localization": { "enum": ["real_retrieval", "not_measured"] }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "reason", "cleanup_verified"],
      "properties": {
        "outcome": { "enum": ["not_applicable", "success", "blocked"] },
        "reason": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "cleanup_verified": { "type": "boolean" }
      }
    },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "replay_digest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/nonempty" }, "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/nonempty" }, "symbol": { "$ref": "#/$defs/nonempty" },
        "relation": { "$ref": "#/$defs/nonempty" }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "original_path", "xy", "submodule"],
      "properties": {
        "kind": { "enum": ["ordinary", "renamed", "deleted", "unmerged", "untracked"] },
        "path": { "$ref": "#/$defs/nonempty" },
        "original_path": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "xy": { "anyOf": [{ "type": "string", "minLength": 2, "maxLength": 2 }, { "type": "null" }] },
        "submodule": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "branch", "upstream", "ahead", "behind", "worktree", "changes"],
      "properties": {
        "head": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{40}$" }, { "type": "null" }] },
        "branch": { "$ref": "#/$defs/nonempty" },
        "upstream": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "ahead": { "type": "integer", "minimum": 0 }, "behind": { "type": "integer", "minimum": 0 },
        "worktree": { "$ref": "#/$defs/nonempty" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workflow_outcome", "selected_workflow_ids", "workflow_ranking", "source_ranking", "observations", "obligations", "repository_state"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "workflow_outcome": { "enum": ["selected", "multi_workflow", "new_workflow_required", "irrelevant"] },
        "selected_workflow_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "workflow_ranking": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["id"],
            "properties": { "id": { "$ref": "#/$defs/nonempty" } }
          }
        },
        "source_ranking": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "symbol"],
            "properties": {
              "path": { "$ref": "#/$defs/nonempty" },
              "symbol": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
            }
          }
        },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/target" } },
        "obligations": { "type": "array", "items": { "$ref": "#/$defs/target" } },
        "repository_state": { "$ref": "#/$defs/state" }
      }
    }
  }
}
