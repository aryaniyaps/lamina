{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/real-repository-oracle-result-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "adapter", "fixture_digest", "collection_id", "collection_digest", "evidence_mode", "claims", "safety", "cases", "materializations", "replay_digest"],
  "properties": {
    "schema": { "const": "lamina.real-repository-oracle-result/v1" },
    "adapter": { "$ref": "#/$defs/adapter" }, "fixture_digest": { "$ref": "#/$defs/sha256" }, "collection_id": { "$ref": "#/$defs/nonempty" }, "collection_digest": { "$ref": "#/$defs/sha256" },
    "evidence_mode": { "enum": ["oracle_validation", "semantic_core", "public_cli"] },
    "claims": {
      "type": "object", "additionalProperties": false, "required": ["end_to_end_runtime", "observation", "obligations", "source_localization"],
      "properties": { "end_to_end_runtime": { "type": "boolean" }, "observation": { "enum": ["brownfield_signals", "public_cli", "not_measured"] }, "obligations": { "enum": ["compiled", "public_cli", "not_measured"] }, "source_localization": { "enum": ["real_retrieval", "not_measured"] } }
    },
    "safety": { "$ref": "#/$defs/safety" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "materializations": { "type": "array", "items": { "$ref": "#/$defs/materialization" } },
    "replay_digest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$" },
    "adapter": { "type": "object", "additionalProperties": false, "required": ["schema", "id", "version", "input_format", "output_format"], "properties": { "schema": { "const": "lamina.real-repository-oracle-adapter/v1" }, "id": { "$ref": "#/$defs/nonempty" }, "version": { "type": "integer", "minimum": 1 }, "input_format": { "const": "lamina.real-repository-oracle-input/v1" }, "output_format": { "$ref": "#/$defs/nonempty" } } },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "report_schema", "report_sha256", "result_sha256", "fixture_digest", "tier", "command_sha256", "source_identity_sha256", "execution_identity_sha256", "promotion_sha256", "collection_digest", "materialization_digests", "runner_outcome", "cleanup_verified"],
      "properties": { "schema": { "const": "lamina.real-repository-oracle-attestation/v1" }, "report_schema": { "const": "lamina.safe-runner-report/v1" }, "report_sha256": { "$ref": "#/$defs/sha256" }, "result_sha256": { "$ref": "#/$defs/sha256" }, "fixture_digest": { "$ref": "#/$defs/sha256" }, "tier": { "enum": ["small", "medium", "large"] }, "command_sha256": { "$ref": "#/$defs/sha256" }, "source_identity_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "execution_identity_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "promotion_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "collection_digest": { "$ref": "#/$defs/sha256" }, "materialization_digests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "runner_outcome": { "enum": ["success", "preflight_refused", "command_failed", "safety_limit_exceeded", "interrupted", "internal_error"] }, "cleanup_verified": { "type": "boolean" } }
    },
    "safety": {
      "type": "object", "additionalProperties": false, "required": ["mode", "outcome", "reason", "attestation"],
      "properties": { "mode": { "enum": ["not_applicable", "unattested", "attested"] }, "outcome": { "enum": ["not_applicable", "pending", "success", "blocked"] }, "reason": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }, "attestation": { "anyOf": [{ "$ref": "#/$defs/attestation" }, { "type": "null" }] } }
    },
    "target": { "type": "object", "additionalProperties": false, "minProperties": 2, "required": ["category"], "properties": { "category": { "$ref": "#/$defs/nonempty" }, "id": { "$ref": "#/$defs/nonempty" }, "path": { "$ref": "#/$defs/relativePath" }, "symbol": { "$ref": "#/$defs/nonempty" }, "relation": { "$ref": "#/$defs/nonempty" } } },
    "change": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "original_path", "xy", "submodule"], "properties": { "kind": { "enum": ["ordinary", "renamed", "copied", "deleted", "unmerged", "untracked"] }, "path": { "$ref": "#/$defs/relativePath" }, "original_path": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] }, "xy": { "anyOf": [{ "type": "string", "minLength": 2, "maxLength": 2 }, { "type": "null" }] }, "submodule": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["head", "branch", "upstream", "ahead", "behind", "worktree_role", "changes"], "properties": { "head": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] }, "branch": { "$ref": "#/$defs/nonempty" }, "upstream": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }, "ahead": { "type": "integer", "minimum": 0 }, "behind": { "type": "integer", "minimum": 0 }, "worktree_role": { "$ref": "#/$defs/nonempty" }, "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } } },
    "case": { "type": "object", "additionalProperties": false, "required": ["id", "workflow_outcome", "selected_workflow_ids", "workflow_ranking", "source_ranking", "observations", "obligations", "repository_state"], "properties": { "id": { "$ref": "#/$defs/nonempty" }, "workflow_outcome": { "enum": ["selected", "multi_workflow", "new_workflow_required", "irrelevant"] }, "selected_workflow_ids": { "type": "array", "minItems": 0, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } }, "workflow_ranking": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/nonempty" } } } }, "source_ranking": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "symbol"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "symbol": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] } } } }, "observations": { "type": "array", "items": { "$ref": "#/$defs/target" } }, "obligations": { "type": "array", "items": { "$ref": "#/$defs/target" } }, "repository_state": { "$ref": "#/$defs/state" } } },
    "materialization": { "type": "object", "additionalProperties": false, "required": ["case_id", "scenario_digest", "provenance_digest", "base_digest", "first_start_digest", "first_end_digest", "replay_start_digest", "replay_end_digest"], "properties": { "case_id": { "$ref": "#/$defs/nonempty" }, "scenario_digest": { "$ref": "#/$defs/sha256" }, "provenance_digest": { "$ref": "#/$defs/sha256" }, "base_digest": { "$ref": "#/$defs/sha256" }, "first_start_digest": { "$ref": "#/$defs/sha256" }, "first_end_digest": { "$ref": "#/$defs/sha256" }, "replay_start_digest": { "$ref": "#/$defs/sha256" }, "replay_end_digest": { "$ref": "#/$defs/sha256" } } }
  }
}
