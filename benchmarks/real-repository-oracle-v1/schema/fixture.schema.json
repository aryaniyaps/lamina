{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/real-repository-oracle-fixture-v1.json",
  "title": "Lamina real-repository oracle fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "collections", "cases", "mutations", "held_out_compatibility"],
  "properties": {
    "schema": { "const": "lamina.real-repository-oracle-fixture/v1" },
    "id": { "$ref": "#/$defs/nonempty" },
    "version": { "const": 1 },
    "collections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/collection" }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "mutations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mutation" } },
    "held_out_compatibility": { "$ref": "#/$defs/heldOut" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "fixture_id", "fixture_class", "repository_url", "commit", "baseline_manifest_sha256", "observation_paths_sha256", "observation_candidate_files", "observation_candidate_bytes", "retrieval_paths_sha256", "retrieval_candidate_files", "retrieval_candidate_bytes", "collection_digest"],
      "properties": {
        "schema": { "const": "lamina.real-repository-collection/v1" },
        "id": { "$ref": "#/$defs/nonempty" },
        "fixture_id": { "enum": ["small", "medium", "large"] },
        "fixture_class": { "enum": ["small", "medium", "large"] },
        "repository_url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "commit": { "$ref": "#/$defs/commit" },
        "baseline_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "observation_paths_sha256": { "$ref": "#/$defs/sha256" },
        "observation_candidate_files": { "type": "integer", "minimum": 1 },
        "observation_candidate_bytes": { "type": "integer", "minimum": 1 },
        "retrieval_paths_sha256": { "$ref": "#/$defs/sha256" },
        "retrieval_candidate_files": { "type": "integer", "minimum": 1 },
        "retrieval_candidate_bytes": { "type": "integer", "minimum": 1 },
        "collection_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/nonempty" },
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/nonempty" },
        "symbol": { "$ref": "#/$defs/nonempty" },
        "relation": { "$ref": "#/$defs/nonempty" }
      }
    },
    "rankedWorkflow": {
      "type": "object", "additionalProperties": false, "required": ["id", "max_rank"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "max_rank": { "type": "integer", "minimum": 1, "maximum": 5 } }
    },
    "rankedSource": {
      "type": "object", "additionalProperties": false, "required": ["path", "symbol", "max_rank"],
      "properties": {
        "path": { "$ref": "#/$defs/nonempty" },
        "symbol": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "max_rank": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "original_path"],
      "properties": {
        "kind": { "enum": ["ordinary", "renamed", "deleted", "unmerged", "untracked"] },
        "path": { "$ref": "#/$defs/nonempty" },
        "original_path": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
      }
    },
    "repositoryState": {
      "type": "object", "additionalProperties": false, "required": ["branch", "worktree", "changes"],
      "properties": {
        "branch": { "$ref": "#/$defs/nonempty" },
        "worktree": { "$ref": "#/$defs/nonempty" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "path", "destination", "value"],
      "properties": {
        "op": { "enum": ["modify", "rename", "delete", "checkout_branch", "add_worktree"] },
        "path": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "destination": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "value": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_outcome", "selected_workflow_ids", "forbidden_workflow_ids", "workflow_ranking", "source_ranking", "observations", "forbidden_observations", "obligations", "forbidden_paths", "repository_state"],
      "properties": {
        "workflow_outcome": { "enum": ["selected", "multi_workflow", "new_workflow_required", "irrelevant"] },
        "selected_workflow_ids": { "$ref": "#/$defs/stringArray" },
        "forbidden_workflow_ids": { "$ref": "#/$defs/stringArray" },
        "workflow_ranking": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/rankedWorkflow" } },
        "source_ranking": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/rankedSource" } },
        "observations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } },
        "forbidden_observations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } },
        "obligations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } },
        "forbidden_paths": { "$ref": "#/$defs/stringArray" },
        "repository_state": { "$ref": "#/$defs/repositoryState" }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "collection_id", "request", "coverage", "repository_scenario", "expected", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "collection_id": { "$ref": "#/$defs/nonempty" },
        "request": { "type": "string", "minLength": 1, "maxLength": 600 },
        "coverage": { "$ref": "#/$defs/stringArray" },
        "repository_scenario": {
          "type": "object", "additionalProperties": false, "required": ["kind", "name", "operations"],
          "properties": {
            "kind": { "enum": ["clean", "dirty", "branch", "worktree"] },
            "name": { "$ref": "#/$defs/nonempty" },
            "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
          }
        },
        "expected": { "$ref": "#/$defs/expected" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "case_id", "kind", "diagnostic_includes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" }, "case_id": { "$ref": "#/$defs/nonempty" },
        "kind": { "$ref": "#/$defs/nonempty" },
        "diagnostic_includes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" } }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_recall_at_5", "source_recall_at_10"],
      "properties": {
        "workflow_recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_id_alias_accuracy", "complete_multi_workflow_selection", "incorrect_new_workflow_attachment", "workflow_recall_at_5", "source_recall_at_10"],
      "properties": {
        "exact_id_alias_accuracy": { "const": 1 },
        "complete_multi_workflow_selection": { "const": 0.95 },
        "incorrect_new_workflow_attachment": { "const": 0.02 },
        "workflow_recall_at_5": { "const": 0.99 },
        "source_recall_at_10": { "const": 0.9275 }
      }
    },
    "heldOut": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark", "split", "workflow_rows", "workflow_rows_bytes", "workflow_rows_sha256", "source_rows", "source_rows_bytes", "source_rows_sha256", "qualified_current", "thresholds"],
      "properties": {
        "benchmark": { "const": "benchmarks/retrieval-v1/benchmark.mjs" },
        "split": { "const": "held_out" },
        "workflow_rows": { "const": 160 },
        "workflow_rows_bytes": { "const": 16928 },
        "workflow_rows_sha256": { "const": "536c7459bb3457ca01b1a5444964bb5cc1d3cea8d7fc3ff5c1c84190f26c9027" },
        "source_rows": { "const": 80 },
        "source_rows_bytes": { "const": 11806 },
        "source_rows_sha256": { "const": "080df00ccec46bf06a7b9336c1defd270a312005e872b1e64f29437e08709f99" },
        "qualified_current": { "$ref": "#/$defs/metrics" },
        "thresholds": { "$ref": "#/$defs/thresholds" }
      }
    }
  }
}
