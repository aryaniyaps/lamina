{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/real-repository-oracle-fixture-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "collections", "cases", "mutations", "held_out_compatibility"],
  "properties": {
    "schema": { "const": "lamina.real-repository-oracle-fixture/v1" },
    "id": { "$ref": "#/$defs/nonempty" }, "version": { "const": 1 },
    "collections": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/collection" } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "mutations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mutation" } },
    "held_out_compatibility": { "$ref": "#/$defs/heldOut" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$" },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "fixture_id", "fixture_class", "repository_url", "commit", "tree_oid", "baseline_manifest_sha256", "candidate_policy_sha256", "observation_paths_sha256", "observation_candidate_files", "observation_candidate_bytes", "retrieval_paths_sha256", "retrieval_candidate_files", "retrieval_candidate_bytes", "collection_digest"],
      "properties": {
        "schema": { "const": "lamina.real-repository-collection/v1" }, "id": { "$ref": "#/$defs/nonempty" },
        "fixture_id": { "enum": ["small", "medium", "large"] }, "fixture_class": { "enum": ["small", "medium", "large"] },
        "repository_url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "commit": { "$ref": "#/$defs/commit" }, "tree_oid": { "$ref": "#/$defs/commit" }, "baseline_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_policy_sha256": { "$ref": "#/$defs/sha256" }, "observation_paths_sha256": { "$ref": "#/$defs/sha256" },
        "observation_candidate_files": { "type": "integer", "minimum": 1 }, "observation_candidate_bytes": { "type": "integer", "minimum": 1 },
        "retrieval_paths_sha256": { "$ref": "#/$defs/sha256" }, "retrieval_candidate_files": { "type": "integer", "minimum": 1 },
        "retrieval_candidate_bytes": { "type": "integer", "minimum": 1 }, "collection_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "caseKind": {
      "type": "object", "additionalProperties": false, "required": ["query", "intent", "scope"],
      "properties": {
        "query": { "enum": ["exact_workflow_id", "exact_workflow_alias", "exact_source_identifier", "route", "handler", "entity", "symbol", "low_overlap_paraphrase", "persona", "permission", "role_boundary", "invariant", "failure_state", "entry_point", "command", "schema_entity", "transition", "event", "test", "docs_persona", "flag", "dependency"] },
        "intent": { "enum": ["workflow_selection", "multi_workflow", "new_workflow", "source_localization", "observation", "obligations", "adversarial"] },
        "scope": { "enum": ["one_file", "multi_file", "repository"] }
      }
    },
    "modifyOperation": { "type": "object", "additionalProperties": false, "required": ["op", "path", "content"], "properties": { "op": { "const": "modify" }, "path": { "$ref": "#/$defs/relativePath" }, "content": { "$ref": "#/$defs/nonempty" } } },
    "renameOperation": { "type": "object", "additionalProperties": false, "required": ["op", "path", "to"], "properties": { "op": { "const": "rename" }, "path": { "$ref": "#/$defs/relativePath" }, "to": { "$ref": "#/$defs/relativePath" } } },
    "deleteOperation": { "type": "object", "additionalProperties": false, "required": ["op", "path"], "properties": { "op": { "const": "delete" }, "path": { "$ref": "#/$defs/relativePath" } } },
    "branchOperation": { "type": "object", "additionalProperties": false, "required": ["op", "branch"], "properties": { "op": { "const": "checkout_branch" }, "branch": { "$ref": "#/$defs/nonempty" } } },
    "worktreeOperation": { "type": "object", "additionalProperties": false, "required": ["op", "branch", "worktree_id"], "properties": { "op": { "const": "add_worktree" }, "branch": { "$ref": "#/$defs/nonempty" }, "worktree_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" } } },
    "operation": { "oneOf": [{ "$ref": "#/$defs/modifyOperation" }, { "$ref": "#/$defs/renameOperation" }, { "$ref": "#/$defs/deleteOperation" }, { "$ref": "#/$defs/branchOperation" }, { "$ref": "#/$defs/worktreeOperation" }] },
    "target": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "required": ["category"],
      "properties": { "category": { "$ref": "#/$defs/nonempty" }, "id": { "$ref": "#/$defs/nonempty" }, "path": { "$ref": "#/$defs/relativePath" }, "symbol": { "$ref": "#/$defs/nonempty" }, "relation": { "$ref": "#/$defs/nonempty" } }
    },
    "rankedWorkflow": { "type": "object", "additionalProperties": false, "required": ["id", "max_rank"], "properties": { "id": { "$ref": "#/$defs/nonempty" }, "max_rank": { "type": "integer", "minimum": 1, "maximum": 5 } } },
    "rankedSource": { "type": "object", "additionalProperties": false, "required": ["path", "symbol", "max_rank"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "symbol": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }, "max_rank": { "type": "integer", "minimum": 1, "maximum": 10 } } },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path", "original_path", "xy", "submodule"],
      "properties": { "kind": { "enum": ["ordinary", "renamed", "copied", "deleted", "unmerged", "untracked"] }, "path": { "$ref": "#/$defs/relativePath" }, "original_path": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] }, "xy": { "anyOf": [{ "type": "string", "minLength": 2, "maxLength": 2 }, { "type": "null" }] }, "submodule": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] } }
    },
    "repositoryState": {
      "type": "object", "additionalProperties": false, "required": ["head", "branch", "upstream", "ahead", "behind", "worktree_role", "changes"],
      "properties": { "head": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] }, "branch": { "$ref": "#/$defs/nonempty" }, "upstream": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }, "ahead": { "type": "integer", "minimum": 0 }, "behind": { "type": "integer", "minimum": 0 }, "worktree_role": { "$ref": "#/$defs/nonempty" }, "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } } }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_outcome", "selected_workflow_ids", "forbidden_workflow_ids", "workflow_ranking", "source_ranking", "observations", "forbidden_observations", "obligations", "forbidden_paths", "repository_state"],
      "properties": {
        "workflow_outcome": { "enum": ["selected", "multi_workflow", "ambiguous", "new_workflow_required"] }, "selected_workflow_ids": { "$ref": "#/$defs/stringArray" }, "forbidden_workflow_ids": { "$ref": "#/$defs/stringArray" },
        "workflow_ranking": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/rankedWorkflow" } }, "source_ranking": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/rankedSource" } },
        "observations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } }, "forbidden_observations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } }, "obligations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/target" } },
        "forbidden_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }, "repository_state": { "$ref": "#/$defs/repositoryState" }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["id", "collection_id", "request", "kind", "repository_scenario", "expected", "rationale"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "collection_id": { "$ref": "#/$defs/nonempty" }, "request": { "type": "string", "minLength": 1, "maxLength": 600 }, "kind": { "$ref": "#/$defs/caseKind" }, "repository_scenario": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "operations"], "properties": { "kind": { "enum": ["clean", "dirty", "branch", "worktree"] }, "name": { "$ref": "#/$defs/nonempty" }, "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } } } }, "expected": { "$ref": "#/$defs/expected" }, "rationale": { "type": "string", "minLength": 1, "maxLength": 300 } }
    },
    "mutation": {
      "type": "object", "additionalProperties": false, "required": ["id", "case_id", "kind", "applicability", "diagnostic_includes"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "case_id": { "$ref": "#/$defs/nonempty" }, "kind": { "enum": ["wrong_workflow", "missing_observation", "unexpected_observation", "lost_obligation", "source_ranking_regression", "extra_workflow", "nondeterministic_replay", "repository_state_mismatch", "stale_rename_path", "stale_delete_path"] }, "applicability": { "enum": ["selected_workflow", "observation", "forbidden_observation", "obligation", "source_ranking", "multi_workflow", "replay", "repository_state", "rename", "delete"] }, "diagnostic_includes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" } } }
    },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["workflow_recall_at_5", "source_recall_at_10"], "properties": { "workflow_recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 }, "source_recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "thresholds": { "type": "object", "additionalProperties": false, "required": ["exact_id_alias_accuracy", "complete_multi_workflow_selection", "incorrect_new_workflow_attachment", "workflow_recall_at_5", "source_recall_at_10"], "properties": { "exact_id_alias_accuracy": { "const": 1 }, "complete_multi_workflow_selection": { "const": 0.95 }, "incorrect_new_workflow_attachment": { "const": 0.02 }, "workflow_recall_at_5": { "const": 0.99 }, "source_recall_at_10": { "const": 0.9275 } } },
    "heldOut": {
      "type": "object", "additionalProperties": false, "required": ["benchmark", "split", "workflow_rows", "workflow_rows_bytes", "workflow_rows_sha256", "source_rows", "source_rows_bytes", "source_rows_sha256", "qualified_current", "thresholds"],
      "properties": { "benchmark": { "const": "benchmarks/retrieval-v1/benchmark.mjs" }, "split": { "const": "held_out" }, "workflow_rows": { "const": 160 }, "workflow_rows_bytes": { "const": 16928 }, "workflow_rows_sha256": { "const": "536c7459bb3457ca01b1a5444964bb5cc1d3cea8d7fc3ff5c1c84190f26c9027" }, "source_rows": { "const": 80 }, "source_rows_bytes": { "const": 11806 }, "source_rows_sha256": { "const": "080df00ccec46bf06a7b9336c1defd270a312005e872b1e64f29437e08709f99" }, "qualified_current": { "$ref": "#/$defs/metrics" }, "thresholds": { "$ref": "#/$defs/thresholds" } }
    }
  }
}
