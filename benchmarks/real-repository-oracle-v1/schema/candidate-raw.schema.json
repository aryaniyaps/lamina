{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamina.dev/schemas/real-repository-oracle-candidate-raw-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "public_input_sha256", "adapter", "persona_probe", "first", "replay"],
  "properties": {
    "schema": { "const": "lamina.real-repository-oracle-candidate-raw/v1" },
    "public_input_sha256": { "$ref": "#/$defs/sha256" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "persona_probe": { "$ref": "#/$defs/personaProbe" },
    "first": { "$ref": "#/$defs/rows" },
    "replay": { "$ref": "#/$defs/rows" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "version", "input_format", "output_format"],
      "properties": {
        "schema": { "const": "lamina.real-repository-oracle-candidate-adapter/v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 2048 },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "input_format": { "const": "lamina.real-repository-oracle-candidate-batch/v1" },
        "output_format": { "const": "lamina.real-repository-oracle-candidate-raw/v1" }
      }
    },
    "personaProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "input_sha256", "observations", "observations_sha256"],
      "properties": {
        "schema": { "const": "lamina.real-repository-oracle-persona-probe-evidence/v1" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "observations": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "contains": {
            "type": "object", "required": ["category"],
            "properties": { "category": { "const": "personas" } }
          },
          "items": { "$ref": "#/$defs/observation" }
        },
        "observations_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["nonce", "order", "result"],
        "properties": {
          "nonce": { "$ref": "#/$defs/sha256" },
          "order": { "type": "integer", "minimum": 1, "maximum": 256 },
          "result": { "$ref": "#/$defs/resultBody" }
        }
      }
    },
    "resultBody": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_outcome", "selected_workflow_ids", "workflow_ranking", "source_ranking", "observations", "obligations", "repository_state"],
      "properties": {
        "workflow_outcome": { "enum": ["selected", "multi_workflow", "ambiguous", "new_workflow_required"] },
        "selected_workflow_ids": { "type": "array", "maxItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "workflow_ranking": {
          "type": "array", "maxItems": 15,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id"],
            "properties": { "id": { "$ref": "#/$defs/nonempty" } }
          }
        },
        "source_ranking": {
          "type": "array", "maxItems": 6000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "symbol"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "symbol": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
            }
          }
        },
        "observations": { "type": "array", "maxItems": 84000, "items": { "$ref": "#/$defs/observation" } },
        "obligations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/obligation" } },
        "repository_state": { "$ref": "#/$defs/repositoryState" }
      }
    },
    "targetFields": {
      "type": "object", "additionalProperties": false, "minProperties": 2,
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/nonempty" },
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/relativePath" },
        "symbol": { "$ref": "#/$defs/nonempty" },
        "relation": { "$ref": "#/$defs/nonempty" }
      }
    },
    "observation": {
      "allOf": [
        { "$ref": "#/$defs/targetFields" },
        { "type": "object", "properties": { "category": { "enum": ["entry_points", "commands", "routes", "handlers", "schemas", "entities", "state_transitions", "permissions", "events", "tests", "documentation", "personas", "feature_flags", "dependencies"] } } }
      ]
    },
    "obligation": {
      "allOf": [
        { "$ref": "#/$defs/targetFields" },
        { "type": "object", "properties": { "category": { "enum": ["implementation", "state", "permission", "failure", "persona", "completeness", "verification"] } } }
      ]
    },
    "repositoryState": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "branch", "upstream", "ahead", "behind", "worktree_role", "changes"],
      "properties": {
        "head": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] },
        "branch": { "$ref": "#/$defs/nonempty" },
        "upstream": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
        "ahead": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "behind": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "worktree_role": { "$ref": "#/$defs/nonempty" },
        "changes": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/change" } }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "original_path", "xy", "submodule"],
      "properties": {
        "kind": { "enum": ["ordinary", "renamed", "copied", "deleted", "unmerged", "untracked"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "original_path": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] },
        "xy": { "anyOf": [{ "type": "string", "minLength": 2, "maxLength": 2 }, { "type": "null" }] },
        "submodule": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
      }
    }
  }
}
