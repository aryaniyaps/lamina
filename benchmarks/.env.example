# Optional bench-only overrides (not required).
# LB6 / Harbor Cursor pilot auth comes from the repo root `.env`:
#
#   CURSOR_API_KEY=...
#   # Optional: build-runtime.mjs auto-fetches the pinned Linux Cursor CLI for Docker.
#   # CURSOR_AGENT_VERSION_DIR is only needed on Linux hosts.
#   HARBOR_API_KEY=...   # only needed for harbor publish/upload
#
# Issue #18 — Harbor RewardKit LLM judge (claim surface rewardkit_llm_judge_v3):
#
#   OPENAI_API_KEY=sk-...
#   REWARDKIT_JUDGE=openai/gpt-5.5
#   # or: LB6_LLM_JUDGE_MODEL=gpt-5.5
#   LITELLM_DROP_PARAMS=1
#
# Install Harbor agent skills locally:
#   npx skills add harbor-framework/harbor --skill publish
#   npx skills add harbor-framework/harbor --skill rewardkit
#
# Legacy / retired:
#   LB6_HOST_SEAL / harbor-fork / private-verifier-v3 (disabled for Issue #18)
#   ANTHROPIC_API_KEY=sk-ant-...  (legacy Harbor v4)
